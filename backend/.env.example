APP_NAME="E-Internship Dishub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL (Next.js)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Database (PostgreSQL Lokal) ───
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=e_internship
DB_USERNAME=postgres
DB_PASSWORD=123

# ─── File Storage (Lokal) ───
FILESYSTEM_DISK=public
STORAGE_DRIVER=local

# ─── Laravel Sanctum ───
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# ─── CORS ───
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Cache & Session ───
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ─── Mail (optional) ───
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@dishub-surabaya.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Algorithm Threshold ───
ALGORITHM_SCORE_THRESHOLD=60
