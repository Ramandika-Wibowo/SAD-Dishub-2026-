APP_NAME="E-Internship Suara Surabaya"
APP_ENV=local
APP_KEY=base64:7K/h3aD9+oZ2zY3qJ7gQ5R1xT8uV4bN0wE6mP9cK2kM=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Frontend URL (Next.js)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# ─── Database (PostgreSQL Lokal) ───
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=e_internship
DB_USERNAME=postgres
DB_PASSWORD=123

# ─── File Storage (Lokal) ───
FILESYSTEM_DISK=public
STORAGE_DRIVER=local

# ─── Laravel Sanctum ───
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
SESSION_DOMAIN=localhost

# ─── CORS ───
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Cache & Session ───
CACHE_DRIVER=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=database

# ─── Algorithm Threshold ───
ALGORITHM_SCORE_THRESHOLD=60
